PORT=5000
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here

# Comma-separated list of origins allowed to call the API (CORS).
# Optional for local dev — defaults to the Vite dev server
# (http://localhost:5173) when unset. Set this in staging/production.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# How long issued JWTs stay valid (jsonwebtoken "zeit/ms" format, e.g.
# 30d, 12h, 3600). Optional — defaults to 30d when unset.
# JWT_EXPIRES_IN=30d
